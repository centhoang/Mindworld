# Copy to .env (gitignored) and fill in. Never commit real keys; never paste them in Discord or chat.
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL=meta-models/muse-spark-open-1026

META_API_KEY=
META_MODEL=muse-spark-1.3

# Modal (workspace proxy token "wk-...ws-..." from `modal workspace proxy-tokens create`; Glimmer URL printed by `modal deploy modal/glimmer_server.py`)
MODAL_PROXY_TOKEN=
# Shared Muse Spark Open endpoint (`modal endpoint create --shared --model meta-models/Muse-Spark-Open-816B-A42B`; URL from `modal endpoint info`)
MODAL_BASE_URL=
MODAL_MODEL=meta-models/Muse-Spark-Open-816B-A42B
# Optional dedicated Muse Glimmer 30B endpoint (needs a card on the Modal workspace; see modal/glimmer_server.py)
MODAL_GLIMMER_URL=
MODAL_GLIMMER_MODEL=glimmer

# spend guard enforced by the LLM wrapper (USD per day; falls back to free policy when hit)
MAX_DAILY_USD=5
