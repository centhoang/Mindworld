{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "client-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "client",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "client-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "client",
        "run",
        "preview",
        "--",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173
    },
    {
      "name": "worker-mock",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "worker",
        "run",
        "dev:mock",
        "--",
        "--port",
        "8799"
      ],
      "env": {
        "WRANGLER_SEND_METRICS": "false"
      },
      "port": 8799
    },
    {
      "name": "worker-live",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "worker",
        "run",
        "dev",
        "--",
        "--port",
        "8787"
      ],
      "env": {
        "WRANGLER_SEND_METRICS": "false"
      },
      "port": 8787
    },
    {
      "name": "client-dev-8788",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "client",
        "run",
        "dev",
        "--",
        "--port",
        "5180",
        "--strictPort"
      ],
      "env": {
        "API_PROXY": "http://127.0.0.1:8788"
      },
      "port": 5180
    },
    {
      "name": "client-dev-room",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "client",
        "run",
        "dev",
        "--",
        "--port",
        "5181",
        "--strictPort"
      ],
      "env": {
        "API_PROXY": "http://127.0.0.1:8799"
      },
      "port": 5181
    }
  ]
}
